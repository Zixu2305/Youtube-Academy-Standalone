# MySQL
MYSQL_VERSION=8.4
MYSQL_PORT=3307

MYSQL_ROOT_PASSWORD=change_me_root #CHANGE THIS
MYSQL_DATABASE=yta
MYSQL_USER=yta
MYSQL_PASSWORD=change_me_user #CHANGE THIS

# Optional: Adminer web UI
ADMINER_PORT=8081

# MongoDB
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_ROOT_USERNAME=yta
MONGO_ROOT_PASSWORD=change_me_mongo #CHANGE THIS
MONGO_DATABASE=yta
MONGO_AUTH_SOURCE=admin

# LLM provider config (shared for quiz generation + query enhancement)
# Supported providers: groq, openai
LLM_PROVIDER=groq
# Preferred shared model/key (works for any provider)
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY= llm_api_key #CHANGE THIS

# Provider-specific fallbacks (used when LLM_MODEL / LLM_API_KEY are empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For python script database connection
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=yta
DB_USER=yta
DB_PASSWORD=change_me_user #CHANGE THIS

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sf_skill_level_docs__bge_base__768
QDRANT_YT_COLLECTION=youtube_videos__bge_base__768

# Embedding model/index defaults
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_VECTOR_DIM=768
EMBEDDING_BATCH_SIZE=32

# Optional: YouTube quota warning thresholds
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_WARNING_THRESHOLD=8000
YOUTUBE_API_KEY=change_me_youtube_api_key #CHANGE THIS

ACADEMY_API_BASE_URL=http://host.docker.internal:8000